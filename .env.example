# Gmail IMAP Credentials for Laya Triage Desk
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password (Name: "Laya Triage")
# 4. Copy the 16-character code below (no spaces):

GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Server & Ingestion Settings
TICKET_SERVER_URL=http://127.0.0.1:8000/api/tickets
POLL_INTERVAL_SECONDS=15
MARK_AS_READ=true
